{
  "model": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "minimax_h3_ref2va_pruned_int8_convrot.safetensors",
      "weight_dtype": "default"
    },
    "_meta": {
      "title": "UNETLoader"
    }
  },
  "clip": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "type": "minimax",
      "device": "default"
    },
    "_meta": {
      "title": "CLIPLoader"
    }
  },
  "vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_video_vae_fp16.safetensors"
    },
    "_meta": {
      "title": "VAELoader"
    }
  },
  "audio_vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_audio_vae_fp32.safetensors"
    },
    "_meta": {
      "title": "VAELoader"
    }
  },
  "source": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "source.mp4"
    },
    "_meta": {
      "title": "LoadVideo"
    }
  },
  "source_parts": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": [
        "source",
        0
      ]
    },
    "_meta": {
      "title": "GetVideoComponents"
    }
  },
  "upscale": {
    "class_type": "H3VideoUpsampler",
    "inputs": {
      "model": [
        "model",
        0
      ],
      "clip": [
        "clip",
        0
      ],
      "vae": [
        "vae",
        0
      ],
      "audio_vae": [
        "audio_vae",
        0
      ],
      "images": [
        "source_parts",
        0
      ],
      "audio": [
        "source_parts",
        1
      ],
      "prompt": "h3upscale, increase resolution and restore fine details while preserving the original content and visual style.",
      "upscale_model": "minimax_h3_latent_upscaler_3d_fp16.safetensors",
      "megapixels": 2.0,
      "denoise": 0.1,
      "lora": "h3upscale_v2_x2.safetensors",
      "lora_strength": 1.0,
      "tile_tokens": 25000,
      "sampler_name": "euler"
    },
    "_meta": {
      "title": "H3VideoUpsampler"
    }
  },
  "video": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "trim",
        0
      ],
      "audio": [
        "source_parts",
        1
      ],
      "fps": 24.0,
      "bit_depth": 8
    },
    "_meta": {
      "title": "CreateVideo"
    }
  },
  "save": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "video",
        0
      ],
      "filename_prefix": "containers/h3_guided_upscale",
      "format": "mp4",
      "codec": "h264"
    },
    "_meta": {
      "title": "SaveVideo"
    }
  },
  "trim": {
    "class_type": "ImageFromBatch",
    "inputs": {
      "image": [
        "upscale",
        0
      ],
      "batch_index": 0,
      "length": 120
    },
    "_meta": {
      "title": "ImageFromBatch"
    }
  }
}
