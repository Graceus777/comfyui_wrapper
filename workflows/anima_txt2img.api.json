{
  "1": {
    "class_type": "UNETLoader",
    "_meta": { "title": "Anima UNET" },
    "inputs": { "unet_name": "waiANIMA_v10Base10.safetensors", "weight_dtype": "default" }
  },
  "2": {
    "class_type": "CLIPLoader",
    "_meta": { "title": "Anima CLIP" },
    "inputs": { "clip_name": "qwen_3_06b_base.safetensors", "type": "stable_diffusion", "device": "default" }
  },
  "3": {
    "class_type": "VAELoader",
    "_meta": { "title": "Anima VAE" },
    "inputs": { "vae_name": "qwen_image_vae.safetensors" }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Positive Prompt" },
    "inputs": { "text": "masterpiece, best quality, score_7, safe, 1girl", "clip": ["2", 0] }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Negative Prompt" },
    "inputs": {
      "text": "worst quality, low quality, score_1, score_2, score_3, artist name, blurry, jpeg artifacts, chromatic aberration",
      "clip": ["2", 0]
    }
  },
  "6": {
    "class_type": "EmptyLatentImage",
    "inputs": { "width": 1024, "height": 1344, "batch_size": 1 }
  },
  "7": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 0,
      "steps": 28,
      "cfg": 4.5,
      "sampler_name": "euler_ancestral",
      "scheduler": "normal",
      "denoise": 1.0,
      "model": ["1", 0],
      "positive": ["4", 0],
      "negative": ["5", 0],
      "latent_image": ["6", 0]
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["7", 0], "vae": ["3", 0] }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": { "filename_prefix": "anima", "images": ["8", 0] }
  }
}
