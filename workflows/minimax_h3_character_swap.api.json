{
  "1": {
    "class_type": "UNETLoader",
    "_meta": { "title": "H3 UNET" },
    "inputs": { "unet_name": "minimax_h3_ref2va_pruned_int8_convrot.safetensors", "weight_dtype": "default" }
  },
  "2": {
    "class_type": "CLIPLoader",
    "_meta": { "title": "H3 CLIP" },
    "inputs": { "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors", "type": "minimax", "device": "default" }
  },
  "3": {
    "class_type": "VAELoader",
    "_meta": { "title": "H3 Video VAE" },
    "inputs": { "vae_name": "minimax_h3_video_vae_int8_convrot.safetensors" }
  },
  "15": {
    "class_type": "VAELoader",
    "_meta": { "title": "H3 Audio VAE" },
    "inputs": { "vae_name": "minimax_h3_audio_vae_fp32.safetensors" }
  },
  "h3_ref_lora": {
    "class_type": "LoraLoaderModelOnly",
    "_meta": { "title": "Ref2V turbo" },
    "inputs": {
      "model": ["1", 0],
      "lora_name": "minimax_h3_turbo_v4_step600_pruned_comfyui.safetensors",
      "strength_model": 1.0
    }
  },
  "16": {
    "class_type": "MiniMaxH3SigmaShift",
    "_meta": { "title": "Sigma Shift" },
    "inputs": { "model": ["h3_ref_lora", 0], "shift_video": 6.0, "shift_audio": 3.0 }
  },
  "h3_ref_char": {
    "class_type": "LoadImage",
    "_meta": { "title": "Character still (<Picture 1>)" },
    "inputs": { "image": "wrapper/h3/character.png" }
  },
  "h3_body": {
    "class_type": "LoadVideo",
    "_meta": { "title": "Source clip" },
    "inputs": { "file": "wrapper/h3/source.mp4" }
  },
  "h3_body_vc": {
    "class_type": "GetVideoComponents",
    "_meta": { "title": "Source frames" },
    "inputs": { "video": ["h3_body", 0] }
  },
  "h3_body_trim": {
    "class_type": "ImageFromBatch",
    "_meta": { "title": "Trim source to latent length" },
    "inputs": { "image": ["h3_body_vc", 0], "batch_index": 0, "length": 124 }
  },
  "h3_sam3": {
    "class_type": "CheckpointLoaderSimple",
    "_meta": { "title": "SAM3 checkpoint" },
    "inputs": { "ckpt_name": "sam3.1_multiplex_fp16.safetensors" }
  },
  "h3_sam3_text": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "SAM3 target" },
    "inputs": { "text": "the person", "clip": ["h3_sam3", 1] }
  },
  "h3_sam3_track": {
    "class_type": "SAM3_VideoTrack",
    "_meta": { "title": "Track the subject" },
    "inputs": {
      "images": ["h3_body_trim", 0],
      "model": ["h3_sam3", 0],
      "conditioning": ["h3_sam3_text", 0],
      "detection_threshold": 0.5,
      "max_objects": 4,
      "detect_interval": 1
    }
  },
  "h3_sam3_mask": {
    "class_type": "SAM3_TrackToMask",
    "_meta": { "title": "Subject mask" },
    "inputs": { "track_data": ["h3_sam3_track", 0], "object_indices": "" }
  },
  "h3_invert": {
    "class_type": "ImageInvert",
    "_meta": { "title": "Invert source colors" },
    "inputs": { "image": ["h3_body_trim", 0] }
  },
  "h3_treat": {
    "class_type": "ImageCompositeMasked",
    "_meta": { "title": "Invert colors inside the mask" },
    "inputs": {
      "destination": ["h3_body_trim", 0],
      "source": ["h3_invert", 0],
      "x": 0,
      "y": 0,
      "resize_source": false,
      "mask": ["h3_sam3_mask", 0]
    }
  },
  "6": {
    "class_type": "MiniMaxH3ReferenceToVideo",
    "_meta": { "title": "Character swap" },
    "inputs": {
      "clip": ["2", 0],
      "vae": ["3", 0],
      "audio_vae": ["15", 0],
      "prompt": "[video editing] Edit <Video 1>. Replace the selected subject with the character in <Picture 1> from the first output frame. Transfer its identity, face, hair, outfit, colors and design while preserving the source performance, timing, camera and unrelated scene details. The original subject's appearance must be replaced, including its inverted colors. The altered colors in the selected source area identify where to regenerate; render natural colors there, not photographic-negative colors.",
      "width": 832,
      "height": 480,
      "length": 124,
      "ref_image_size": "match",
      "ref_images.ref_image_0": ["h3_ref_char", 0],
      "ref_videos.ref_video_0": ["h3_treat", 0]
    }
  },
  "7": {
    "class_type": "BasicGuider",
    "inputs": { "model": ["16", 0], "conditioning": ["6", 0] }
  },
  "8": {
    "class_type": "RandomNoise",
    "inputs": { "noise_seed": 0 }
  },
  "9": {
    "class_type": "KSamplerSelect",
    "inputs": { "sampler_name": "res_multistep" }
  },
  "10": {
    "class_type": "BasicScheduler",
    "inputs": { "model": ["16", 0], "scheduler": "simple", "steps": 8, "denoise": 1.0 }
  },
  "11": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["8", 0],
      "guider": ["7", 0],
      "sampler": ["9", 0],
      "sigmas": ["10", 0],
      "latent_image": ["6", 1]
    }
  },
  "12": {
    "class_type": "VAEDecodeTiled",
    "_meta": { "title": "VAE Decode (tiled)" },
    "inputs": {
      "samples": ["11", 1],
      "vae": ["3", 0],
      "tile_size": 512,
      "overlap": 64,
      "temporal_size": 32,
      "temporal_overlap": 8
    }
  },
  "17": {
    "class_type": "VAEDecodeAudio",
    "_meta": { "title": "VAE Decode Audio" },
    "inputs": { "samples": ["11", 1], "vae": ["15", 0] }
  },
  "13": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["12", 0],
      "fps": 24.0,
      "audio": ["17", 0],
      "bit_depth": 8
    }
  },
  "14": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["13", 0],
      "filename_prefix": "h3_char_swap",
      "format": "mp4",
      "codec": "h264"
    }
  }
}
