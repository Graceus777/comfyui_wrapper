{
  "1": {
    "class_type": "UNETLoader",
    "_meta": { "title": "H3 UNET" },
    "inputs": { "unet_name": "minimax_h3_fl2va_pruned_w4a8_mixed.safetensors", "weight_dtype": "default" }
  },
  "h3_head_lora": {
    "class_type": "LoraLoaderModelOnly",
    "_meta": { "title": "Head swap LoRA" },
    "inputs": {
      "model": ["1", 0],
      "lora_name": "minimax_h3_head_swap_v1.0_r32.safetensors",
      "strength_model": 1.0
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "_meta": { "title": "H3 CLIP" },
    "inputs": { "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors", "type": "minimax", "device": "default" }
  },
  "3": {
    "class_type": "VAELoader",
    "_meta": { "title": "H3 Video VAE" },
    "inputs": { "vae_name": "minimax_h3_video_vae_fp16.safetensors" }
  },
  "15": {
    "class_type": "VAELoader",
    "_meta": { "title": "H3 Audio VAE" },
    "inputs": { "vae_name": "minimax_h3_audio_vae_fp32.safetensors" }
  },
  "16": {
    "class_type": "MiniMaxH3SigmaShift",
    "_meta": { "title": "Sigma Shift" },
    "inputs": { "model": ["h3_head_lora", 0], "shift_video": 12.0, "shift_audio": 3.0 }
  },
  "h3_face": {
    "class_type": "LoadImage",
    "_meta": { "title": "Face still (<Picture 1>)" },
    "inputs": { "image": "wrapper/h3/face.png" }
  },
  "h3_body": {
    "class_type": "LoadVideo",
    "_meta": { "title": "Source clip (<Video 1>)" },
    "inputs": { "file": "wrapper/h3/body.mp4" }
  },
  "h3_body_vc": {
    "class_type": "GetVideoComponents",
    "_meta": { "title": "Source frames" },
    "inputs": { "video": ["h3_body", 0] }
  },
  "h3_body_trim": {
    "class_type": "ImageFromBatch",
    "_meta": { "title": "Trim source to latent length" },
    "inputs": { "image": ["h3_body_vc", 0], "batch_index": 0, "length": 124 }
  },
  "6": {
    "class_type": "MiniMaxH3ReferenceToVideo",
    "_meta": { "title": "Face reference" },
    "inputs": {
      "clip": ["2", 0],
      "vae": ["3", 0],
      "audio_vae": ["15", 0],
      "prompt": "head_swap:",
      "width": 832,
      "height": 480,
      "length": 124,
      "ref_image_size": "match",
      "ref_images.ref_image_0": ["h3_face", 0]
    }
  },
  "h3_guide": {
    "class_type": "MiniMaxH3AddGuide",
    "_meta": { "title": "Aligned source guide" },
    "inputs": {
      "positive": ["6", 0],
      "vae": ["3", 0],
      "latent": ["6", 1],
      "image": ["h3_body_trim", 0],
      "frame_idx": 0
    }
  },
  "7": {
    "class_type": "BasicGuider",
    "inputs": { "model": ["16", 0], "conditioning": ["h3_guide", 0] }
  },
  "8": {
    "class_type": "RandomNoise",
    "inputs": { "noise_seed": 0 }
  },
  "9": {
    "class_type": "KSamplerSelect",
    "inputs": { "sampler_name": "euler" }
  },
  "10": {
    "class_type": "BasicScheduler",
    "inputs": { "model": ["16", 0], "scheduler": "simple", "steps": 8, "denoise": 1.0 }
  },
  "11": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["8", 0],
      "guider": ["7", 0],
      "sampler": ["9", 0],
      "sigmas": ["10", 0],
      "latent_image": ["6", 1]
    }
  },
  "12": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["11", 0], "vae": ["3", 0] }
  },
  "17": {
    "class_type": "VAEDecodeAudio",
    "_meta": { "title": "VAE Decode Audio" },
    "inputs": { "samples": ["11", 0], "vae": ["15", 0] }
  },
  "13": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["12", 0],
      "fps": 24.0,
      "audio": ["17", 0],
      "bit_depth": 8
    }
  },
  "14": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["13", 0],
      "filename_prefix": "h3_head_swap",
      "format": "mp4",
      "codec": "h264"
    }
  }
}
