{
  "1": {
    "class_type": "UNETLoader",
    "_meta": { "title": "H3 UNET" },
    "inputs": { "unet_name": "minimax_h3_fl2va_pruned_int8_convrot.safetensors", "weight_dtype": "default" }
  },
  "2": {
    "class_type": "CLIPLoader",
    "_meta": { "title": "H3 CLIP" },
    "inputs": { "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors", "type": "minimax", "device": "default" }
  },
  "3": {
    "class_type": "VAELoader",
    "_meta": { "title": "H3 Video VAE" },
    "inputs": { "vae_name": "minimax_h3_video_vae_fp16.safetensors" }
  },
  "15": {
    "class_type": "VAELoader",
    "_meta": { "title": "H3 Audio VAE" },
    "inputs": { "vae_name": "minimax_h3_audio_vae_fp32.safetensors" }
  },
  "16": {
    "class_type": "MiniMaxH3SigmaShift",
    "_meta": { "title": "Sigma Shift" },
    "inputs": { "model": ["1", 0], "shift_video": 12.0, "shift_audio": 3.0 }
  },
  "4": {
    "class_type": "LoadImage",
    "inputs": { "image": "example.png" }
  },
  "5": {
    "class_type": "ImageScale",
    "inputs": {
      "image": ["4", 0],
      "upscale_method": "lanczos",
      "width": 832,
      "height": 480,
      "crop": "center"
    }
  },
  "6": {
    "class_type": "MiniMaxH3ImageToVideo",
    "_meta": { "title": "H3 I2V" },
    "inputs": {
      "clip": ["2", 0],
      "vae": ["3", 0],
      "prompt": "integrated_multimodal_description: A single continuous locked-off shot from the reference image. Natural continuous environmental motion only; no camera cut, zoom, reversal, or end freeze.",
      "width": 832,
      "height": 480,
      "length": 124,
      "first_frame": ["5", 0]
    }
  },
  "7": {
    "class_type": "BasicGuider",
    "inputs": { "model": ["16", 0], "conditioning": ["6", 0] }
  },
  "8": {
    "class_type": "RandomNoise",
    "inputs": { "noise_seed": 0 }
  },
  "9": {
    "class_type": "KSamplerSelect",
    "inputs": { "sampler_name": "res_multistep" }
  },
  "10": {
    "class_type": "BasicScheduler",
    "inputs": { "model": ["16", 0], "scheduler": "simple", "steps": 12, "denoise": 1.0 }
  },
  "11": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["8", 0],
      "guider": ["7", 0],
      "sampler": ["9", 0],
      "sigmas": ["10", 0],
      "latent_image": ["6", 1]
    }
  },
  "12": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["11", 0], "vae": ["3", 0] }
  },
  "17": {
    "class_type": "VAEDecodeAudio",
    "_meta": { "title": "VAE Decode Audio" },
    "inputs": { "samples": ["11", 0], "vae": ["15", 0] }
  },
  "13": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["12", 0],
      "fps": 24.0,
      "audio": ["17", 0],
      "bit_depth": 8
    }
  },
  "14": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["13", 0],
      "filename_prefix": "h3_loop",
      "format": "mp4",
      "codec": "h264"
    }
  }
}
